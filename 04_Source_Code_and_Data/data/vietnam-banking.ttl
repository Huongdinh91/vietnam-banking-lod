:dataset a void:Dataset ;
    dcterms:created "2026-10-06"^^xsd:date ;
    dcterms:creator "Nhóm 24, IT6390E Semantic Web, Đại học Bách khoa Hà Nội"@vi ;
    dcterms:description "Linked Open Data dataset describing Vietnamese banks, bank types, locations and banking services."@en ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    dcterms:source <https://en.wikipedia.org/wiki/List_of_banks_in_Vietnam> ;
    dcterms:title "Vietnam Banking Linked Open Data"@en,
        "Dữ liệu mở liên kết ngân hàng Việt Nam"@vi ;
    void:dataDump :vietnam-banking.ttl ;
    void:exampleResource <https://data.example.org/vietnam-banking/bank/vietcombank> ;
    void:triples 1067 ;
    void:uriSpace "https://data.example.org/vietnam-banking/" ;
    void:vocabulary dcterms:,
        :,
        schema: .

:providesService a owl:ObjectProperty ;
    rdfs:domain :Bank ;
    rdfs:range :Service .

:hasBankType a owl:ObjectProperty ;
    rdfs:domain :Bank ;
    rdfs:range :BankType .

