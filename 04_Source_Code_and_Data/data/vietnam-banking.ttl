@prefix : <https://data.example.org/vietnam-banking/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:created a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

:DigitalBank a owl:Class ;
    rdfs:subClassOf :Bank ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Bank [ a owl:Restriction ;
                        owl:hasValue <https://data.example.org/vietnam-banking/service/digital-banking> ;
                        owl:onProperty :providesService ] ) ] .

:EstablishedBefore1991Bank a owl:Class ;
    rdfs:subClassOf :Bank ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Bank [ a owl:Restriction ;
                        owl:onProperty :foundedYear ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1990 ] ) ] ] ) ] .

:ForeignBank a owl:Class ;
    rdfs:subClassOf :Bank ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Bank [ a owl:Restriction ;
                        owl:hasValue <https://data.example.org/vietnam-banking/bank-type/foreign-owned> ;
                        owl:onProperty :hasBankType ] ) ] .

:JointStockBank a owl:Class ;
    rdfs:subClassOf :Bank ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Bank [ a owl:Restriction ;
                        owl:hasValue <https://data.example.org/vietnam-banking/bank-type/joint-stock-commercial> ;
                        owl:onProperty :hasBankType ] ) ] .

:StateOwnedBank a owl:Class ;
    rdfs:subClassOf :Bank ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Bank [ a owl:Restriction ;
                        owl:hasValue <https://data.example.org/vietnam-banking/bank-type/state-commercial> ;
                        owl:onProperty :hasBankType ] ) ] .

:abbreviation a owl:DatatypeProperty ;
    rdfs:domain :Bank ;
    rdfs:range xsd:string .

