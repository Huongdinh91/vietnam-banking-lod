        :Location ;
    rdfs:label "Vietnam"@en,
        "Việt Nam"@vi ;
    owl:sameAs <http://dbpedia.org/resource/Vietnam>,
        <http://www.wikidata.org/entity/Q881> .

:Bank a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :operatesInCountry ;
            owl:someValuesFrom :Location ],
        [ a owl:Restriction ;
            owl:onProperty :providesService ;
            owl:someValuesFrom :Service ],
        [ a owl:Restriction ;
            owl:onClass :BankType ;
            owl:onProperty :hasBankType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Location ;
            owl:onProperty :hasHeadquarters ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty :bankId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        schema:BankOrCreditUnion ;
    owl:disjointWith :BankType,
        :Location,
        :Service .

